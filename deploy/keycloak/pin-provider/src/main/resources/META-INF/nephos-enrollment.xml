<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
 <changeSet id="nephos-enrollment-1" author="nephos">
  <createTable tableName="NEPHOS_ENROLLMENT">
   <column name="ID" type="VARCHAR(200)"><constraints primaryKey="true" nullable="false"/></column>
   <column name="KIND" type="VARCHAR(20)"><constraints nullable="false"/></column>
   <column name="SUBJECT_ID" type="VARCHAR(36)"/>
   <column name="EXPIRES_AT" type="BIGINT"><constraints nullable="false"/></column>
   <column name="PAYLOAD" type="TEXT"><constraints nullable="false"/></column>
  </createTable>
  <createIndex tableName="NEPHOS_ENROLLMENT" indexName="IDX_NEPHOS_ENROLL_SUBJECT">
   <column name="SUBJECT_ID"/><column name="KIND"/>
  </createIndex>
  <insert tableName="NEPHOS_ENROLLMENT">
   <column name="ID" value="lock"/><column name="KIND" value="lock"/>
   <column name="EXPIRES_AT" valueNumeric="0"/><column name="PAYLOAD" value="{}"/>
  </insert>
 </changeSet>
</databaseChangeLog>
